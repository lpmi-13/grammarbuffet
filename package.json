  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
    "axe-core": "^4.13.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^3.0.12"
